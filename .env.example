# Copy to .env and fill in values. Never commit .env.
# The backend reads ./.env (repo root) or backend/.env; Docker Compose reads ./.env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database: Supabase PostgreSQL (required) ---
# Supabase dashboard -> Connect -> "Session pooler" connection string (IPv4, port 5432).
# postgresql:// is accepted and converted to postgresql+asyncpg:// automatically, and SSL is
# required for Supabase hosts. URL-encode special characters in the password (@ -> %40, / -> %2F).
# Do NOT use the transaction pooler (port 6543): it breaks asyncpg's prepared statements.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Tests migrate a database down to empty, so they use a SEPARATE database (never the one above).
# Leave unset to use a local SQLite file. Tests refuse to run if this equals DATABASE_URL.
# TEST_DATABASE_URL=

# --- AI provider: Gemini (all agents share the key pool) ---
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Unset/blank keys are skipped; at least one is needed for AI features (the rest of the API
# works without any). A rate-limited key is skipped for this long, unless Gemini says otherwise.
GEMINI_KEY_COOLDOWN_SECONDS=60

# Defaults for every LLM request (agents may override per call).
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# Future (not used yet): local inference through Ollama + Qwen.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Agent safety limits ---
MAX_AGENT_STEPS=8
# LLM_MAX_RETRIES: retries (on another key when possible) after a retryable Gemini failure.
LLM_MAX_RETRIES=2
TOOL_MAX_RETRIES=2

# --- GitHub webhook (optional; the core demo works without it) ---
GITHUB_WEBHOOK_SECRET=

# --- Frontend (inlined into the browser bundle at build time; never put secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
